{
  "manifest_version": 3,
  "name": "Project Manager",
  "version": "0.54.1",
  "description": "Detects when an AI-assisted project is circling rather than progressing.",
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://pm-proxy.noamros13.workers.dev/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Project Manager",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://pm-proxy.noamros13.workers.dev"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/report_view.js",
        "lib/ui.css",
        "lib/report.css"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ]
    }
  ]
}
